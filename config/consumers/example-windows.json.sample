{
  "name": "example-windows",
  "repo": "your-account/your-windows-repo",
  "visibility": "public",
  "backend": "vmss",
  "os": "windows",
  "labels": [
    "ghr-example-windows"
  ],
  "vmSize": "Standard_D4ds_v5",
  "maxRunners": 1,
  "jobTimeoutMinutes": 30,
  "allowedEvents": [
    "workflow_dispatch"
  ],
  "allowedRefs": [
    "refs/heads/main"
  ],
  "allowedWorkflows": [
    "your-account/your-windows-repo/.github/workflows/windows-job.yml@refs/heads/main"
  ],
  "notes": "Example Windows consumer for the isolated VMSS Flex runner. See ADR-0007."
}

